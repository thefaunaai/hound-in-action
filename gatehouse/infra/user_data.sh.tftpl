#!/bin/bash
set -euo pipefail

dnf install -y docker git
systemctl start docker

git clone --depth 1 --branch "${source_branch}" https://github.com/thefaunaai/hound-in-action.git /opt/gatehouse
cd /opt/gatehouse/gatehouse

docker build -t gatehouse .
docker run \
  --detach \
  --name gatehouse \
  --env SES_REGION="${aws_region}" \
  --env MAIL_FROM="${mail_from}" \
  --env ALLOWED_EMAIL="${allowed_email}" \
  --env PORT=3000 \
  --publish 3000:3000 \
  gatehouse

for i in $(seq 1 30); do
  if curl -fsS http://127.0.0.1:3000/health >/dev/null; then
    touch /opt/gatehouse-ready
    exit 0
  fi
  sleep 2
done

docker logs --tail=80 gatehouse
exit 1
